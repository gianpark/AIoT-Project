venv/
env/

# 모델 파일은 용량이 커서 git에 안 올리고 각자 Kaggle에서 받는다 (README 참고)
models/*.tflite

# 수집한 원본 이미지/영상은 git에 안 올린다 (개인정보 + 용량)
data/raw/
data/snaps/
# IRB 원본 RGB-D(얼굴 포함)와 공유 패키지·share_map(내부 코드 대응)은 절대 올리지 않는다
data/raw_rgbd/
share/

# 라벨링 교차검증용 블라인드 샘플 사진도 data/raw/ 원본의 복사본이라 마찬가지로 제외
# (scripts/prepare_blind_relabel_sample.py 참고) — 매핑/결과 CSV는 메타데이터만 담아 git에 올림
data/relabel_blind/

# 외부 공개 데이터셋(WRF 논문 등)은 각자 스크립트 안내대로 다시 받는다 (git에 안 올림)
data/external_wrf/

